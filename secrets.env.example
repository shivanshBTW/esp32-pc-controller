# Copy this file to secrets.env and edit.
# secrets.env is gitignored — never commit real passwords.
#
#   cp secrets.env.example secrets.env
#
# This becomes the WakeType "device key" (web UI / API password).
# After changing it, rebuild and flash:
#   idf.py build flash
#
# If the board already has an old key in flash, set FORCE=1 once to overwrite.

WAKETYPE_DEVICE_KEY=pick-a-password-you-will-remember
WAKETYPE_FORCE_DEVICE_KEY=0
