menu "ESP32 PC Controller"

    config PC_WIFI_SSID
        string "Wi-Fi SSID"
        default ""
        help
            Home Wi-Fi network name. Leave empty to skip Wi-Fi until configured.

    config PC_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""
        help
            Home Wi-Fi password. Do not commit real credentials to a public repo.

    config PC_API_TOKEN
        string "Local API bearer token"
        default "CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
        help
            Shared secret for authenticated LAN API requests.
            Generate a long random string before deploying.

    config PC_POWER_RELAY_GPIO
        int "POWER relay GPIO"
        default 4
        range 0 48

    config PC_RESET_RELAY_GPIO
        int "RESET relay GPIO"
        default 5
        range 0 48

    config PC_STATE_GPIO
        int "PC power-state sense GPIO (PC817)"
        default 6
        range 0 48

    config PC_RELAY_ACTIVE_LOW
        bool "Relay modules are active-low"
        default y
        help
            Most optocoupler relay boards: GPIO LOW = ON, GPIO HIGH = OFF.

    config PC_POWER_PRESS_MS
        int "Normal power press duration (ms)"
        default 500
        range 50 2000

    config PC_RESET_PRESS_MS
        int "Reset press duration (ms)"
        default 500
        range 50 2000

    config PC_DEFAULT_LONG_PRESS_MS
        int "Default long power hold (ms)"
        default 5000
        range 1000 8000

    config PC_MAX_RELAY_HOLD_MS
        int "Absolute maximum relay hold (ms)"
        default 8000
        range 1000 8000

endmenu
